{"version":"0.3.0","body":"// Basisinterfaces für SharePoint-Strukturen\ninterface SPBaseFieldValue {\n    __metadata?: {\n        type: string;\n    };\n}\n\ninterface SPUserFieldValue extends SPBaseFieldValue {\n    LookupId: number;\n    LookupValue: string;\n    Email: string;\n}\n\ninterface SPVersionBase {\n    VersionId: number;\n    VersionLabel: string;\n    Modified: string;\n    ID: number;\n    [key: string]: unknown;\n}\n\n// Überarbeitetes FieldChange Interface\ninterface FieldChange {\n    fieldName: string;\n    oldValue: string;\n    newValue: string;\n    fieldType?: string;\n}\n\n// Überarbeitetes VersionChangeResult Interface\ninterface VersionChangeResult {\n    versionInfo: {\n        currentVersion: string;\n        previousVersion: string;\n        modifiedDate: string;\n        itemId: number;\n    };\n    changes: FieldChange[];\n}\n\n// Interface für die JSON-Struktur\ninterface SharePointVersionData {\n    d: {\n        results: SPVersionBase[];\n    }\n}\n\nfunction main(workbook: ExcelScript.Workbook, _jsonContent:string) {\n\n    const jsonData: SharePointVersionData = JSON.parse(_jsonContent);\n    console.log(analyzeVersionChanges(jsonData));\n    return analyzeVersionChanges(jsonData);\n}\n\nfunction analyzeVersionChanges(data: { d: { results: SPVersionBase[] } }): VersionChangeResult {\n    const systemFieldPrefixes: string[] = [\n        '__metadata',\n        'IsCurrentVersion',\n        'CreatedBy',\n        'Fields',\n        'VersionId',\n        'VersionLabel',\n        'Modified',\n        'AppEditor',\n        '__deferred',\n        'ContentTypeId',\n        'FileVersion',\n        'OData_',\n        'File_x005f',\n        'WorkflowVersion',\n        'FSObjType',\n        'ProgId',\n        'FileRef',\n        'FileDirRef',\n        'MetaInfo',\n        'SMTotal',\n        'AccessPolicy',\n        '_UIVersion',\n        'owshiddenversion',\n        'ContentVersion'\n    ];\n\n    const versions = data.d.results.sort((a, b) => b.VersionId - a.VersionId);\n    const currentVersion = versions[0];\n    const previousVersion = versions[1];\n\n    const result: VersionChangeResult = {\n        versionInfo: {\n            currentVersion: currentVersion.VersionLabel,\n            previousVersion: previousVersion.VersionLabel,\n            modifiedDate: new Date(currentVersion.Modified).toLocaleString('de-DE'),\n            itemId: currentVersion.ID\n        },\n        changes: []\n    };\n\n    for (const field in currentVersion) {\n        if (systemFieldPrefixes.some(prefix => field.startsWith(prefix))) {\n            continue;\n        }\n\n        const currentValue = currentVersion[field];\n        const previousValue = previousVersion[field];\n\n        if (JSON.stringify(currentValue) !== JSON.stringify(previousValue)) {\n            let change: FieldChange;\n\n            if (isUserField(currentValue)) {\n                change = {\n                    fieldName: field,\n                    oldValue: formatUserFieldValue(previousValue as SPUserFieldValue),\n                    newValue: formatUserFieldValue(currentValue as SPUserFieldValue),\n                    fieldType: 'User'\n                };\n            } else if (typeof currentValue === 'boolean') {\n                change = {\n                    fieldName: field,\n                    oldValue: String(previousValue),\n                    newValue: String(currentValue),\n                    fieldType: 'Boolean'\n                };\n            } else {\n                change = {\n                    fieldName: field,\n                    oldValue: formatFieldValue(previousValue),\n                    newValue: formatFieldValue(currentValue),\n                    fieldType: typeof currentValue\n                };\n            }\n\n            result.changes.push(change);\n        }\n    }\n\n    return result;\n}\n\nfunction isUserField(value: unknown): value is SPUserFieldValue {\n    return Boolean(\n        value &&\n        typeof value === 'object' &&\n        value !== null &&\n        '__metadata' in value &&\n        (value as SPUserFieldValue).__metadata?.type === 'SP.FieldUserValue'\n    );\n}\n\nfunction formatUserFieldValue(userField: SPUserFieldValue | null): string {\n    if (!userField) return 'Nicht zugewiesen';\n    return `${userField.LookupValue} (${userField.Email})`;\n}\n\nfunction formatFieldValue(value: unknown): string {\n    if (value === null || value === undefined) return 'Nicht zugewiesen';\n    if (typeof value === 'object') return JSON.stringify(value);\n    return String(value);\n}","description":"","noCodeMetadata":"","parameterInfo":"{\"version\":1,\"originalParameterOrder\":[{\"name\":\"_jsonContent\",\"index\":0}],\"parameterSchema\":{\"type\":\"object\",\"required\":[\"_jsonContent\"],\"properties\":{\"_jsonContent\":{\"type\":\"string\"}}},\"returnSchema\":{\"type\":\"object\",\"properties\":{\"result\":{\"type\":\"object\",\"properties\":{\"versionInfo\":{\"type\":\"object\",\"properties\":{\"currentVersion\":{\"type\":\"string\"},\"previousVersion\":{\"type\":\"string\"},\"modifiedDate\":{\"type\":\"string\"},\"itemId\":{\"type\":\"number\"}}},\"changes\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"fieldName\":{\"type\":\"string\"},\"oldValue\":{\"type\":\"string\"},\"newValue\":{\"type\":\"string\"},\"fieldType\":{\"type\":\"string\"}}}}}}}},\"signature\":{\"comment\":\"\",\"parameters\":[{\"name\":\"workbook\",\"comment\":\"\"},{\"name\":\"_jsonContent\",\"comment\":\"\"}]}}","apiInfo":"{\"variant\":\"synchronous\",\"variantVersion\":2}"}